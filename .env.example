# Variables de entorno para Sistema Distribuidora
# Copiá este archivo como .env y completá los valores correspondientes.
# IMPORTANTE: Nunca agregues claves reales ni subas el archivo .env a Git.

# Supabase (Base de datos PostgreSQL y Auth)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-clave-anonima-publica

# SERVICE_ROLE_KEY es de uso EXCLUSIVO para el backend (apps/api). NUNCA compartirla en el frontend ni en repositorios.
SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role-privada

# Seguridad / Desarrollo
# Habilita la acción destructiva de reinicio de base operativa para pruebas (debe ser false en producción)
HABILITAR_REINICIO_DE_FABRICA=false

# Admin Web (Opcional: en desarrollo Vite proxifica automáticamente /api a http://localhost:3000)
# VITE_API_URL=http://localhost:3000

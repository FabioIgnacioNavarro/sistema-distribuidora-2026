# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem

# Estos archivos de entorno locales se ignoran para evitar que se suban al repositorio y se compartan con otros desarrolladores. 
#Esto es importante para mantener la seguridad y la privacidad de las variables de entorno que pueden contener información sensible, 
#como claves de API o credenciales de base de datos.
.env.local
.env*.local
.env

# Ignorar la carpeta .pnpm-store para evitar subir dependencias de paquetes a Git.
# Esto es útil para mantener el repositorio limpio y evitar conflictos de versiones de paquetes entre diferentes entornos de desarrollo.
.pnpm-store/
.expo/